.offer-block
    .offer-block__decor-item.offer-block__decor-item--top
    .offer-block__decor-item.offer-block__decor-item--bottom
    .offer-block__container
        .offer-block__header-block 
            .offer-block__subtitle 
                .tag #предпродажа по специальной цене
            .offer-block__main-header-block
                h2.offer-block__title Оформите ранний доступ к курсу 
                    span.offer-block__title--highlight-light со скидкой 35%
        ul.offer-block__features-list
            li.offer-block__features-list-item
                .offer-block__features-list-icon 
                    img(src="img/icon/flash.webp", alt="")
                p Участницы получат доступ к курсу первыми
            li.offer-block__features-list-item
                .offer-block__features-list-icon 
                    img(src="img/icon/mind.webp", alt="")
                p В первом потоке курса индивидуальная обратная связь от Светланы Грин
            li.offer-block__features-list-item
                .offer-block__features-list-icon 
                    img(src="img/icon/time.webp", alt="")
                p Скидка действует до [указать дату]
        .offer-block__price-card 
            include ../price-card/price-card