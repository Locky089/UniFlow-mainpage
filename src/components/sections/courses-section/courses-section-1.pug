.courses-section(id="fundamental-courses")
    .courses-section__inner
        .courses-section__container
            .courses-section__header
                .courses-section__header-text
                    h2.courses-section__title Фундаментальные курсы
                    p.courses-section__description Структурированый подход, отдельные видеоуроки, мастер-классы и другие материалы, необходимые для решения конкретной задачи.
                a(href="https://uniflow.fit/shop#osnovnye-kursy" target="_blank" rel="noopener").link Все курсы
                    span.link__icon 
                        +svg("16", "16", "chevron-right") 
            .courses-section__cards-block.swiper.swiper-courses-fundamental-js
                .courses-section__cards-block-wrapper.swiper-wrapper
                    .swiper-slide
                        include ../../course-card/course-card-1
                    .swiper-slide
                        include ../../course-card/course-card-2
                    .swiper-slide
                        include ../../course-card/course-card-3
                    .swiper-slide
                        include ../../course-card/course-card-5
                    .swiper-slide
                        include ../../course-card/course-card-4