
include ../../format-card/format-card

.format-section
    .format-section__container
        .format-section__header-block 
            .format-section__subtitle 
                .tag #формат курса
            .format-section__main-header-block
                h2.format-section__title Все для вашего комфорта и устойчивых результатов
                p.format-section__description Всего 15 минут и ваше тело наполнится энергией, легкостью, свободой.
        .format-section__cards-block
            +format-card('img/format-cards/lesson', 'Ежедневные видеоуроки по 15 минут', '')
            +format-card('img/format-cards/roll-up', 'В каждом — сочетание мягкой растяжки и миофасциального релиза', 'format-card--inverse')
            +format-card('img/format-cards/calendar', 'Первые изменения вы почувствуете уже в конце первой недели', 'format-card--inverse format-card--inverse--md-full-height')
            +format-card('img/format-cards/roll', 'Всё, что нужно — массажный ролл, коврик и немного пространства дома', '')
            +format-card('img/format-cards/1', 'Подходит даже для тех, кто очень сильно устает', '')
