.team-section(id="team")
    .team-section__container
        .team-section__header
            .team-section__subtitle 
                .tag # команда uniflow
            .team-section__header-block
                h2.team-section__title Кто стоит за вашими результатами и бесперебойной работой платформы
        .team-section__content
            .team-section__slider.swiper-team-js.swiper
                .team-section__slider-wrapper.swiper-wrapper
                    .team-section__slider-item.swiper-slide
                        .team-section__slide-content
                            .team-section__photo
                                img(src="img/team/team-1.webp", alt="Светлана Грин")
                            .team-section__info
                                .team-section__name Светлана Грин, соосновательница UniFlow
                                .team-section__description Профессиональный балет подарил мне проблемы со спиной и суставами, решить которые помог уникальный подход, разработанный мной за 17 лет работы тренером и реализованный на собственной платформе Uniflow, на которой зарегистрировано и занимается более 120 тыс. клиентов.
                    .team-section__slider-item.swiper-slide
                        .team-section__slide-content
                            .team-section__photo
                                img(src="img/team/team-2.webp", alt="Светлана Грин")
                            .team-section__info
                                .team-section__name Светлана Грин, соосновательница UniFlow
                                .team-section__description Профессиональный балет подарил мне проблемы со спиной и суставами, решить которые помог уникальный подход, разработанный мной за 17 лет работы тренером и реализованный на собственной платформе Uniflow, на которой зарегистрировано и занимается более 120 тыс. клиентов.
                .team-section__slider-pagination.swiper-pagination
                
            
