.benefit-section(id="benefit")
    .benefit-section__container
        .benefit-section__header 
            .benefit-section__subtitle 
                .tag # преимущества занятий с uniflow
            .benefit-section__header-block
                h2.benefit-section__title Как UniFlow меняет тело и подход к тренировкам дома
        .benefit-section__content 
            .benefit-section__row-md-1
                .benefit-section__col-md-5
                    .benefit-card.benefit-card--1
                        .benefit-card__content
                            h3.benefit-card__title Вы избавитесь  от напряжения и вернете телу легкость
                            p.benefit-card__description Мы подберем безопасные классы с учётом особенностей вашего тела и уровня подготовки.
                .benefit-section__col-md-7
                    .benefit-section__row-wrapper
                        .benefit-card.benefit-card--2
                            .benefit-card__content
                                h3.benefit-card__title Увидите результат и сохраните мотивацию
                                p.benefit-card__description Регулярность станет естественной привычкой, а тело ответит улучшением тонуса во всем теле.
                    .benefit-section__content-wrapper-row
                        .benefit-card.benefit-card--3
                            .benefit-card__icon 
                                img(src="img/svg/body.svg", alt="", width="36", height="36", loading="lazy")
                            h3.benefit-card__title Мягко вернете тонус и подтянутость мышц на этапе возрастных изменений
                        .benefit-card.benefit-card--4
                            .benefit-card__icon 
                                img(src="img/svg/woman.svg", alt="", width="36", height="36", loading="lazy")
                            h3.benefit-card__title Перестанете метаться между трендовыми тренировками и получите четкий план занятий
            .benefit-section__row-md-2
                .benefit-section__col-md-4
                    .benefit-card.benefit-card--5
                        .benefit-card__image-block
                            img(src="img/benefit/list.png", alt="", width="240", height="90", loading="lazy")
                        h3.benefit-card__title Отработаете правильную и безопасную технику выполнения упражнений
                .benefit-section__col-md-8
                    .benefit-card.benefit-card--6
                        .benefit-card__content
                            h3.benefit-card__title Сможете тренироваться регулярно даже при плотном графике
                            p.benefit-card__description Короткие зарядки позволят оставаться в тонусе, а супер-серии дадут полноценную нагрузку мышцам всего тела.
