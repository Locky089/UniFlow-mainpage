include ../../promo-card/promo-card

.program-section
    .program-section__container
        .program-section__header-block
            .program-section__subtitle
                .tag # клубная карта uniflow
            .program-section__main-header-block
                h2.program-section__title Форматы занятий, которые мягко и системно ведут вас к сильному и гибкому телу
        .program-section__content
            .program-section__features-block-container
                .program-section__features-block
                    .program-section__left
                        .program-section__left-content
                            .program-section__left-content-inner
                                .program-section__left-content-text
                                    h2.program-section__title Тренировки по Клубной Карте
                                    p.program-section__description Клубная Карта включает в себя активности в 4 форматах, для поддержания энергии и мотивации на пути к здоровому и подтянутому телу.
                                +button-link('Начать бесплатно', 'button--main button--l')
                    .program-section__right
                        .program-section__block
                            .program-block.program-block--1
                                .program-block__content
                                    .program-block__title Тематические недели
                                    .program-block__description Каждая Тематическая неделя — это работа с одной конкретной задачей: спина, гибкость, пресс, ягодицы, осанка. Данный формат помогает избавиться от хаоса и чувствовать, что вы точно двигаетесь в правильном направлении, замечая первые изменения уже к концу недели.
                        .program-section__block
                            .program-block.program-block--2
                                .program-block__content
                                    .program-block__title Живые тренировки
                                    .program-block__description 30-минутные тренировки в прямом эфире быстро снимают напряжение, разгружают спину и возвращают лёгкость. Тренер помогает адаптировать технику для безопасности упражнений и отвечает на вопросы, а рекомендации после занятия закрепляют результат.
                        .program-section__block
                            .program-block.program-block--3
                                .program-block__content
                                    .program-block__title Зарядки и супер-серии
                                    .program-block__description Зарядки — это занятия от 5 до 15 минут для любого времени дня, которые легко встроить в график. Супер-серии — мощные 30–40-минутные комбинации, которые решают сразу несколько задач: укрепляют мышцы, улучшают мобильность и гибкость, снимая напряжение.
                        .program-section__block
                            .program-block.program-block--4
                                .program-block__content
                                    .program-block__title Персональные программы
                                    .program-block__description Вы получаете индивидуальный план на каждый день: что делать, как сочетать занятия и как менять тренировки, если день загружен. Формат убирает хаос, делает занятия безопасными и помогает постепенно возвращать тонус, гибкость и уверенную осанку без изматывающей нагрузки.
            .program-section__courses
                include ../courses-section/courses-section-1
                include ../courses-section/courses-section-2
            .program-section__promo-block
                +promo-card('Зарегистрируйтесь и получите 3 дня бесплатного доступа с программой, подобранной под ваши задачи.')
